# Copie ce fichier en backend/.env (local) et remplis les valeurs. NE JAMAIS commiter backend/.env.
# En production (Vercel), saisis ces variables dans Settings → Environment Variables.
# Ne déploie jamais un fichier contenant des secrets.

# --- Obligatoire ---
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# URL PostgreSQL (Neon : Connection string, avec ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/app?sslmode=require

# --- Environnement ---
# development (local) | production (obligatoire sur Vercel : cookies sécurisés, SECRET_KEY exigée)
APP_ENV=development
# 1 = mode debug Flask, uniquement en local
FLASK_DEBUG=0

# --- Assistant IA (Google Gemini) ---
GEMINI_API_KEY=
# Comptes autorisés à ouvrir /admin (liste d'e-mails séparés par des virgules)
ADMIN_EMAILS=
# GEMINI_MODEL=
# GEMINI_MODELES_SECOURS=
# GEMINI_TIMEOUT_SECONDES=60

# --- Codes de vérification et liens de réinitialisation (Brevo prioritaire si complet) ---
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# Adresse expéditeur validée dans Brevo
EMAIL_EXPEDITEUR=

# Gmail est utilisé pour les autres e-mails et comme solution de repli.
# Mot de passe d'APPLICATION Google, pas le mot de passe du compte
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Envoi des candidatures ---
# test = les candidatures sont envoyées à TON adresse uniquement ; reel = envoi aux entreprises
MODE_ENVOI=test
# 1 = affiche le code de vérification dans le terminal (développement uniquement)
AFFICHER_CODE_TERMINAL=0
