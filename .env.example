# Copie ce fichier en backend/.env (local) et remplis les valeurs. NE JAMAIS commiter backend/.env.
# En production (Render), ces variables se saisissent dans le tableau de bord, pas dans un fichier.

# --- Obligatoire ---
# Générer : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# URL PostgreSQL (Neon : Connection string, avec ?sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOTE/BASE?sslmode=require

# --- Environnement ---
# development (défaut en local) | production (obligatoire en ligne : cookies sécurisés, SECRET_KEY exigée)
APP_ENV=development
# 1 = mode debug Flask, uniquement en local
FLASK_DEBUG=0

# --- Assistant IA (Google Gemini) ---
GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_MODELES_SECOURS=
# GEMINI_TIMEOUT_SECONDES=60

# --- Emails (code de vérification, mot de passe oublié, candidatures) ---
GMAIL_ADDRESS=
# Mot de passe d'APPLICATION Google (pas le mot de passe du compte)
GMAIL_APP_PASSWORD=
# test = les candidatures sont envoyées à TON adresse uniquement ; reel = envoi aux entreprises
MODE_ENVOI=test
# 1 = affiche le code de vérification dans le terminal (développement uniquement)
AFFICHER_CODE_TERMINAL=0
